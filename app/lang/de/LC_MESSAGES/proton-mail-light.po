msgid "Tour"
msgstr "Rundgang"

msgctxt "Say"
msgid "A short look at where things are in the window."
msgstr "Ein kurzer Blick darauf, wo im Fenster was ist."

msgctxt "Say"
msgid "Take the tour"
msgstr "Rundgang starten"

msgctxt "App"
msgid "Skip"
msgstr "Überspringen"

