msgstr "Внутри приложения что-то сломалось. Подробности в журнале."

msgctxt "Auth"
msgid "This connection failed its security check, so nothing was sent. Someone on the network may be interfering, your computer's clock may be wrong, or the app needs an update."
msgstr "Соединение не прошло проверку безопасности, поэтому ничего не отправлено. Возможно, кто-то вмешивается в сеть, на компьютере неверное время или приложение нужно обновить."

msgctxt "Auth"
msgid "Cannot reach Proton. If this client is open on a public domain, Proton refuses direct requests from it."
msgstr "Нет связи с Proton. Если клиент открыт с публичного домена, Proton не принимает с него прямые запросы."

msgctxt "Auth"
msgid "Wrong password"
msgstr "Неверный пароль"

msgctxt "Auth"
msgid "Proton is not available right now. Try again in a minute."
msgstr "Proton временно недоступен. Попробуйте через минуту."

msgctxt "Auth"
msgid "Proton is not available right now. You are still signed in, and the app will carry on by itself."
msgstr "Proton временно недоступен. Вы остаётесь в аккаунте, приложение подключится само."

msgctxt "Auth"
msgid "No connection to Proton. Connecting…"
msgstr "Нет связи с Proton. Подключаемся…"

msgctxt "Auth"
msgid "A lightweight client for Proton Mail"
msgstr "Лёгкий клиент для Proton Mail"

msgctxt "Auth"
msgid "This session is no longer valid"
msgstr "Сессия больше не действует"

msgctxt "Auth"
msgid "Proton no longer accepts it. This happens after signing out on another device, changing the password or revoking the session in Proton's settings. The session and keys were removed from this device, so please sign in again."
msgstr "Proton больше её не принимает. Так бывает, если вы вышли на другом устройстве, сменили пароль или отозвали сессию в настройках Proton. Сессия и ключи удалены с этого устройства, войдите снова."

msgctxt "Auth"
msgid "Username or email"
msgstr "Имя пользователя или email"

msgctxt "Auth"
msgid "Password"
msgstr "Пароль"

msgctxt "Auth"
msgid "Signing in…"
msgstr "Вход…"

msgctxt "Auth"
msgid "Sign in"
msgstr "Войти"

msgctxt "Auth"
msgid "Two-factor code"
msgstr "Код двухфакторной защиты"

msgctxt "Auth"
msgid "Enter one of the recovery codes you saved when you set up two-factor authentication."
msgstr "Введите один из кодов восстановления, сохранённых при настройке двухфакторной защиты."

msgctxt "Auth"
msgid "Enter the six digits from your authenticator app."
msgstr "Введите шесть цифр из приложения-аутентификатора."

msgctxt "Auth"
msgid "Recovery code"
msgstr "Код восстановления"

msgctxt "Auth"
msgid "Confirm"
msgstr "Подтвердить"

msgctxt "Auth"
msgid "Use the authenticator app"
msgstr "Использовать приложение-аутентификатор"

msgctxt "Auth"
msgid "Use a recovery code"
msgstr "Использовать код восстановления"

msgctxt "Auth"
msgid "Mailbox password"
msgstr "Пароль почтового ящика"

msgctxt "Auth"
msgid "Unlock"
msgstr "Разблокировать"

msgctxt "Auth"
msgid "The app is locked"
msgstr "Приложение заблокировано"

msgctxt "Auth"
msgid "App password"
msgstr "Пароль приложения"

msgctxt "Auth"
msgid "Too many attempts. Try again in {}"
msgstr "Слишком много попыток. Повторите через {}"

msgctxt "Auth"
msgid "Use Touch ID"
msgstr "Использовать Touch ID"

msgctxt "Auth"
msgid "Forgot the password"
msgstr "Забыл пароль"


msgctxt "Auth"
msgid "Unofficial client. Not affiliated with Proton AG."
msgstr "Неофициальный клиент. Не имеет отношения к Proton AG."

msgctxt "Auth"
msgid "Back to sign-in"
msgstr "Назад ко входу"

msgctxt "Auth"
msgid "Proton verification"
msgstr "Проверка Proton"

msgctxt "Auth"
msgid "Open the verification page"
msgstr "Открыть страницу проверки"

msgctxt "Auth"
msgid "Check again"
msgstr "Проверить ещё раз"

msgctxt "Auth"
msgid "Proton wants to confirm you are human. Complete the check on the page that opens and come back: the sign-in continues by itself."
msgstr "Proton хочет убедиться, что вы человек. Пройдите проверку на открывшейся странице и вернитесь сюда: вход продолжится сам."

msgctxt "Auth"
msgid "Sign out"
msgstr "Выйти"

msgctxt "Auth"
msgid "Sign out of this account?"
msgstr "Выйти из аккаунта?"

msgctxt "Auth"
msgid "The session ends, and mail saved on this computer is erased."
msgstr "Сессия завершится, а письма, сохранённые на этом компьютере, будут стёрты."

