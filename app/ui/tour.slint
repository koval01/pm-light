// A short tour of the window for someone who opened the app for the first time. Every step can be left at once:
// "Skip" is on every card, and Escape does the same. The window is dimmed around the part a step is about.

import { Theme } from "base.slint";

// The part of the window a step is about. A width of zero means a card in the middle, with nothing lit.
export struct TourSpot {
    x: length,
    y: length,
    width: length,
    height: length,
    title: string,
    text: string,
}

component TourButton {
    in property <string> text;
    in property <bool> strong;
    callback clicked();
    height: 32px;
    min-width: label.preferred-width + 28px;
    Rectangle {
        border-radius: 8px;
        background: root.strong ? Theme.strong : (touch.has-hover ? Theme.hover : transparent);
        border-width: root.strong ? 0 : 1px;
        border-color: Theme.border;
    }
    label := Text {
        text: root.text;
        color: root.strong ? Theme.on-strong : Theme.foreground;
        font-size: 13px;
        font-weight: root.strong ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Tour {
    in property <TourSpot> spot;
    in property <int> step;
    in property <int> steps;
    in property <string> word-skip;
    in property <string> word-back;
    in property <string> word-next;
    in property <string> word-start;
    in property <string> word-done;
    callback next();
    callback back();
    callback skip();

    private property <bool> lit: root.spot.width > 0;
    private property <length> gap: 14px;
    private property <length> card-width: min(340px, root.width - 32px);
    // Beside the lit part where there is room, else below it, else above it; always inside the window.
    private property <bool> fits-right: root.spot.x + root.spot.width + root.gap + root.card-width <= root.width - 8px;
    private property <bool> fits-left: root.spot.x - root.gap - root.card-width >= 8px;
    private property <length> card-x: !root.lit ? (root.width - root.card-width) / 2
        : root.fits-right ? root.spot.x + root.spot.width + root.gap
        : root.fits-left ? root.spot.x - root.gap - root.card-width
        : max(8px, min(root.width - root.card-width - 8px, root.spot.x + root.spot.width - root.card-width));
    private property <length> wanted-y: !root.lit ? (root.height - card.height) / 2
        : (root.fits-right || root.fits-left) ? root.spot.y
        : root.spot.y + root.spot.height + root.gap + card.height <= root.height - 8px ? root.spot.y + root.spot.height + root.gap
        : root.spot.y - root.gap - card.height;
    private property <length> card-y: max(8px, min(root.height - card.height - 8px, root.wanted-y));
    private property <brush> dim: #000000a6;

    // The window around the lit part is dimmed, and takes no clicks: the tour is left by its own buttons.
    if !root.lit: Rectangle { background: root.dim; }
    if root.lit: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: max(0, root.spot.y - 4px);
        background: root.dim;
    }
    if root.lit: Rectangle {
        x: 0;
        y: root.spot.y + root.spot.height + 4px;
        width: root.width;
        height: max(0, root.height - self.y);
        background: root.dim;
    }
    if root.lit: Rectangle {
        x: 0;
        y: max(0, root.spot.y - 4px);
        width: max(0, root.spot.x - 4px);
        height: root.spot.height + 8px;
        background: root.dim;
    }
    if root.lit: Rectangle {
        x: root.spot.x + root.spot.width + 4px;
        y: max(0, root.spot.y - 4px);
        width: max(0, root.width - self.x);
        height: root.spot.height + 8px;
        background: root.dim;
    }
    if root.lit: Rectangle {
        x: root.spot.x - 4px;
        y: root.spot.y - 4px;
        width: root.spot.width + 8px;
        height: root.spot.height + 8px;
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    TouchArea { }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.skip();
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.Return {
                root.next();
                return accept;
            }
            if event.text == Key.LeftArrow && root.step > 1 {
                root.back();
                return accept;
            }
            return reject;
        }
    }

    card := Rectangle {
        x: root.card-x;
        y: root.card-y;
        width: root.card-width;
        height: column.preferred-height;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        animate x, y { duration: 180ms; easing: ease-out; }
        column := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text {
                text: root.spot.title;
                color: Theme.foreground;
                font-size: 16px;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.spot.text;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 8px;
                // Leaving is always one click away, on the left where it is seen first.
                if root.step < root.steps: TourButton {
                    text: root.word-skip;
                    clicked => { root.skip(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.step > 1 && root.step < root.steps: TourButton {
                    text: root.word-back;
                    clicked => { root.back(); }
                }
                TourButton {
                    text: root.step == 1 ? root.word-start : root.step == root.steps ? root.word-done : root.word-next;
                    strong: true;
                    clicked => { root.next(); }
                }
            }
            if root.step > 1 && root.step < root.steps: Text {
                text: (root.step - 1) + " / " + (root.steps - 2);
                color: Theme.faint;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
    }
}
