        if key == "connection.torExit" { return @tr("Through an exit relay"); }
        if key == "connection.torState" { return @tr("State"); }
        if key == "connection.torNew" { return @tr("New circuits"); }
        if key == "connection.torNewDone" { return @tr("New circuits are used from now on."); }
        if key == "privacy.gravatar" { return @tr("Pictures from Gravatar"); }
        if key == "privacy.gravatarHint" { return @tr("For senders with no logo. Gravatar learns, in coded form, who writes to you."); }
        if key == "privacy.gravatarTitle" { return @tr("Ask Gravatar for pictures?"); }
        if key == "privacy.gravatarText" { return @tr("For each sender without a logo, the app asks Gravatar, a service of Automattic, for a picture. The request goes through Proton, so Gravatar does not see your address, but it gets each sender's address in coded form, which is enough to tell who you write with. Proton sees the requests too."); }
        if key == "privacy.gravatarYes" { return @tr("Ask Gravatar"); }
        if key == "settings.notificationsRefused" { return @tr("The system does not allow this app notifications, so neither they nor the count on its icon are shown. Only you can allow them, in the system's settings."); }
        if key == "settings.notificationsOpen" { return @tr("Open the system's notification settings"); }
        if key == "look.menuBarIcon" { return @tr("Icon in the menu bar"); }
        if key == "look.menuBarIconHint" { return @tr("Shows the mail not yet read, and opens the app. The Dock does both too."); }
        if key == "privacy.screenTitle" { return @tr("Privacy on screen"); }
        if key == "privacy.hide" { return @tr("Cover private details"); }
        if key == "privacy.hideHint" { return @tr("Addresses, IP addresses and the like stay covered until you point at them, for a screen others can see."); }
        if key == "tour.title" { return @tr("Tour"); }
        if key == "tour.about" { return @tr("A short look at where things are in the window."); }
        if key == "tour.again" { return @tr("Take the tour"); }
        if key == "about.licenseTitle" { return @tr("License"); }
        if key == "about.license" { return @tr("Free software under the GNU Affero General Public License, version 3, with additional terms: every copy and every changed version keeps the author's name and the link to this repository, and a changed version says that it is changed. It comes with no warranty."); }
        if key == "about.readLicense" { return @tr("Read the license"); }
        if key == "about.componentsTitle" { return @tr("Components"); }
        if key == "about.components" { return @tr("Built from {{count}} open-source components. Their licenses allow this use, and their texts come with the program."); }
        if key == "about.search" { return @tr("Search by name or license"); }
        if key == "about.readNotices" { return @tr("Read the licenses of the components"); }
        if key == "about.more" { return @tr("{{count}} more: search to find them."); }
        if key == "about.nothing" { return @tr("Nothing found."); }
        if key == "tabs.tor" { return @tr("Tor"); }
        if key == "tor.off" { return @tr("Tor is off"); }
        if key == "connection.toTor" { return @tr("Tor settings and the circuit"); }
        if key == "tor.toConnection" { return @tr("Connection and response times"); }
        if key == "connection.torYou" { return @tr("You"); }
        if key == "connection.torYouDetail" { return @tr("This computer. Only the entry relay sees its address, and the app does not ask anyone for it."); }
        if key == "connection.torEntry" { return @tr("Entry relay"); }
        if key == "connection.torEntryDetail" { return @tr("Sees your address, not where you go."); }
        if key == "connection.torMiddle" { return @tr("Middle relay"); }
        if key == "connection.torMiddleDetail" { return @tr("Sees neither you nor Proton."); }
        if key == "connection.torMeeting" { return @tr("Meeting point"); }
        if key == "connection.torMeetingDetail" { return @tr("Your circuit meets Proton's here. It sees neither side."); }
        if key == "connection.torExitRelay" { return @tr("Exit relay"); }
        if key == "connection.torExitDetail" { return @tr("Sees that Proton is reached, not by whom. What is sent stays encrypted."); }
        if key == "connection.torProtonRelays" { return @tr("Proton's relays"); }
        if key == "connection.torProtonRelaysDetail" { return @tr("Hidden: an onion site does not show its circuit, nor where its server is."); }
        if key == "connection.torProtonExit" { return @tr("Reached by name: the exit relay looks the address up itself and does not pass it back."); }
        if key == "connection.torProton" { return @tr("Proton's server"); }
        if key == "connection.restartTitle" { return @tr("Start the app again?"); }
        if key == "connection.restartText" { return @tr("How the app connects changes only at a start, so that nothing of the old way is still under way."); }
        if key == "connection.restart" { return @tr("Start again"); }
        if key == "tor.starting" { return @tr("Tor · connecting {{percent}}%"); }
