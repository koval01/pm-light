// Rust asks here for text by a key. A new key goes here and into both files in `app/lang`.

export global Say {
    public pure function text(key: string) -> string {
        if key == "account.ends" { return @tr("active until {{date}}"); }
        if key == "account.plan" { return @tr("Plan"); }
        if key == "account.planFree" { return @tr("Free"); }
        if key == "account.planPaid" { return @tr("Paid"); }
        if key == "account.renews" { return @tr("renews {{date}}"); }
        if key == "app.offline" { return @tr("No connection to Proton. New mail will appear once it is back."); }
        if key == "app.unavailable" { return @tr("Proton is having trouble. You are still signed in, and new mail will appear once it passes."); }
        if key == "app.untrusted" { return @tr("This connection failed its security check, so nothing was sent. Someone on the network may be interfering, your computer's clock may be wrong, or the app needs an update."); }
        if key == "apps.android" { return @tr("Proton Mail for Android"); }
        if key == "apps.bridge" { return @tr("Proton Mail Bridge"); }
        if key == "apps.bridgeAbout" { return @tr("Lets Outlook, Thunderbird and Apple Mail use your account."); }
        if key == "apps.computer" { return @tr("On a computer"); }
        if key == "apps.desktop" { return @tr("Proton Mail for desktop"); }
        if key == "apps.ios" { return @tr("Proton Mail for iPhone and iPad"); }
        if key == "apps.mobile" { return @tr("On your phone"); }
        if key == "apps.open" { return @tr("Open"); }
        if key == "backup.about" { return @tr("Proton's Export Tool saves all your mail to this computer. It is a separate app for macOS, Windows and Linux, because the mail has to be decrypted on your side."); }
        if key == "backup.get" { return @tr("Get the Export Tool"); }
        if key == "billing.credit" { return @tr("Credit"); }
        if key == "billing.creditAvailable" { return @tr("Available credit"); }
        if key == "billing.default" { return @tr("Default"); }
        if key == "billing.ends" { return @tr("Ends on"); }
        if key == "billing.invoiceDetails" { return @tr("Details on invoices"); }
        if key == "billing.invoiceSaved" { return @tr("Invoice details saved"); }
        if key == "billing.invoices" { return @tr("Invoices"); }
        if key == "billing.manageHint" { return @tr("Changing the plan, payment methods and downloading invoices happen on Proton's website."); }
        if key == "billing.methods" { return @tr("Payment methods"); }
        if key == "billing.months" { return @tr("{{count}} months"); }
        if key == "billing.otherState" { return @tr("Closed"); }
        if key == "billing.paid" { return @tr("billing.paid" => "Paid"); }
        if key == "billing.price" { return @tr("Paid for this period"); }
        if key == "billing.renews" { return @tr("Renews on"); }
        if key == "billing.unpaid" { return @tr("Unpaid"); }
        if key == "cache.about" { return @tr("Mail is encrypted and opens at once, even after a restart. The key stays with the session, so with an app password mail cannot be read without it. Signing out or turning this off erases everything."); }
        if key == "cache.keep" { return @tr("Keep read mail on this computer"); }
        if key == "cache.title" { return @tr("Mail storage"); }
        if key == "common.cancel" { return @tr("Cancel"); }
        if key == "common.create" { return @tr("Create"); }
        if key == "common.loading" { return @tr("Loading…"); }
        if key == "common.save" { return @tr("Save"); }
        if key == "compose.expires" { return @tr("Delete the message after"); }
        if key == "compose.expiresDay" { return @tr("1 day"); }
        if key == "compose.expiresFourWeeks" { return @tr("4 weeks"); }
        if key == "compose.expiresHour" { return @tr("1 hour"); }
        if key == "compose.expiresNever" { return @tr("Never"); }
        if key == "compose.expiresWeek" { return @tr("1 week"); }
        if key == "compose.password" { return @tr("Password for recipients outside Proton"); }
        if key == "compose.passwordHelp" { return @tr("Share it with the recipient some other way."); }
        if key == "compose.passwordHint" { return @tr("Password hint"); }
        if key == "compose.pickTime" { return @tr("Pick a time"); }
        if key == "compose.protonFooter" { return @tr("Sent with {{link}} secure email."); }
        if key == "compose.readReceipt" { return @tr("Request a read receipt"); }
        if key == "compose.schedule" { return @tr("Schedule"); }
        if key == "compose.scheduled" { return @tr("Message scheduled"); }
        if key == "compose.scheduledFor" { return @tr("Sending: {{when}}"); }
        if key == "compose.sent" { return @tr("Message sent"); }
        if key == "compose.subject" { return @tr("Subject"); }
        if key == "compose.tomorrowMorning" { return @tr("Tomorrow morning"); }
        if key == "compose.undo" { return @tr("Undo"); }
        if key == "connection.about" { return @tr("How long the servers take to answer. Measured on this computer, only when you open this tab or press the button."); }
        if key == "connection.measure" { return @tr("Measure again"); }
        if key == "connection.torTitle" { return @tr("Tor"); }
        if key == "connection.torAbout" { return @tr("Tor sends the app's connections through three relays run by volunteers, so that Proton and your network cannot see your address."); }
        if key == "connection.tor" { return @tr("Use Tor"); }
        if key == "connection.torHint" { return @tr("The app starts again to change this."); }
        if key == "connection.torRoute" { return @tr("Route"); }
